{
  "name": "NflxMultiSubs 2021 (Netflix Multi. Subtitles)",
  "description": "Bilingual Subtitles for the Netflix Web App. An actively maintained fork with various bugfixes and improvements.",
  "version": "1.0.0",
  "manifest_version": 3,
  "author": "Dan Chen, Gert Mertes",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.netflix.com/watch/*",
    "https://assets.nflxext.com/*"
  ],
  "background": {
    "service_worker": "service_worker.min.js",
    "type": "module"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.netflix.com/*"
      ],
      "js": [
        "content.min.js"
      ],
      "run_at": "document_start"
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://www.netflix.com/*"
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "nflxmultisubs.min.js"
      ],
      "matches": [
        "https://www.netflix.com/*"
      ]
    }
  ],
  "action": {
    "default_icon": "icon-gray.png",
    "default_popup": "settings.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
